# Doxygen 配置：微观契约层（头文件 /// 注释）
#
# 分层口径见 CONTRIBUTING.md文档规范：/// 注释是单个符号与单个模块的背景/
# 定位，doc/*.rst 是跨模块设计规格。两站各自构建，RST 站不归 Doxygen 管。
#
# 路径按从仓根执行 doxygen doc/Doxyfile写；Doxygen 的相对路径以当前
# 工作目录为基准，不以本文件位置为基准。
#
# 告警面：WARN_AS_ERROR=YES，但未写注释不算告警（EXTRACT_ALL +
# WARN_IF_UNDOCUMENTED=NO），门禁挡的是写错的文档（坏 @ref、坏命令、
# 参数名对不上），不是没写的文档。

PROJECT_NAME           = "libgarena"
PROJECT_BRIEF          = "通用内存所有权治理库：bump Arena 与生成式句柄池双层原语"
OUTPUT_DIRECTORY       = doc/_apidoc
QUIET                  = YES   # 只留告警：门禁的日志就是告警清单

INPUT                  = src/garena
FILE_PATTERNS          = *.hpp
RECURSIVE              = YES
EXCLUDE_PATTERNS       = */_build/* */_apidoc/*

EXTRACT_ALL            = YES
EXTRACT_PRIVATE        = NO
WARN_AS_ERROR          = YES
WARN_IF_UNDOCUMENTED   = NO
WARN_IF_DOC_ERROR      = YES
WARN_IF_INCOMPLETE_DOC = NO
WARN_FORMAT            = "$file:$line: $text"

GENERATE_HTML          = YES
GENERATE_LATEX         = NO
HTML_EXTRA_STYLESHEET  =
SEARCHENGINE           = NO

MARKDOWN_SUPPORT       = YES
AUTOLINK_SUPPORT       = YES
JAVADOC_AUTOBRIEF      = NO
QT_AUTOBRIEF           = NO
MULTILINE_CPP_IS_BRIEF = NO

DOT_IMAGE_FORMAT       = svg
HAVE_DOT               = NO

ALPHABETICAL_INDEX     = NO
DISABLE_INDEX          = YES
GENERATE_TREEVIEW      = YES
FULL_SIDEBAR           = YES
